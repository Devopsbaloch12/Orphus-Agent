# ---------------------------------------------------------------------------
# Orphus environment configuration
#
# Copy to `.env` and fill in. Never commit `.env`.
# Every value here overrides the corresponding key in config/default.yaml.
# Nested config keys use a double underscore: ORPHUS_ASR__DEVICE=cuda:0
# ---------------------------------------------------------------------------

# --- LLM provider (required) ------------------------------------------------
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKER_COUNT=4

# --- Datastores -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://orphus:orphus@localhost:5432/orphus

# --- GPU --------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=0

# --- Model paths ------------------------------------------------------------
# Left blank => resolved under MODEL_ROOT by the loader, downloaded by deploy.sh.
MODEL_ROOT=./models
ASR_MODEL_PATH=
TTS_MODEL_PATH=
VAD_MODEL_PATH=

# --- Concurrency and limits -------------------------------------------------
MAX_CONCURRENT_SESSIONS=20
REQUEST_TIMEOUT=30

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json

# --- Auth (required in production; comma-separated shared keys) ------------
ORPHUS_API_KEYS=
