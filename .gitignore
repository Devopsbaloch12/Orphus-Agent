# Vendored upstream model repos: cloned by deploy.sh for reference
vendor/

# Audio scratch
*.wav
*.mp3
!tests/fixtures/**/*.wav

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
HANDOFF.md
